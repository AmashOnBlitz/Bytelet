{
  "comments": { "lineComment": "//", "blockComment": [ "/*", "*/" ] },
  "brackets": [ [ "{", "}" ], [ "(", ")" ], [ "[", "]" ] ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "\"", "close": "\"" }
  ],
  "wordPattern": "(-?\\d+\\.\\d+)|(-?\\d+)|([a-zA-Z_][a-zA-Z0-9_]*)"
}
